{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Specification",
  "type": "object",
  "required": [
    "product_id",
    "name",
    "product_type",
    "product_modality",
    "target_customer",
    "problem",
    "job_to_be_done",
    "transformation",
    "promise",
    "unique_mechanism",
    "positioning",
    "quality_criteria"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Unique identifier, e.g. PROD-001"
    },
    "name": {
      "type": "string",
      "description": "Working product name or title"
    },
    "product_type": {
      "type": "string",
      "description": "High-level classification (document, template, web_application, mobile_application, desktop_application, interactive_tool, api_service, database_product, automation, ai_product, hybrid)"
    },
    "product_modality": {
      "type": "string",
      "enum": [
        "document",
        "template",
        "productivity_artifact",
        "interactive_tool",
        "web_application",
        "mobile_application",
        "tablet_application",
        "desktop_application",
        "browser_extension",
        "cli_developer_tool",
        "api_service",
        "database_product",
        "data_product",
        "automation_workflow",
        "ai_product",
        "multimedia",
        "education",
        "game_interactive",
        "plugin_integration",
        "bot",
        "device_companion",
        "xr_3d",
        "hybrid"
      ],
      "description": "Selected primary delivery modality"
    },
    "modality_comparison": {
      "type": "object",
      "description": "Explicit comparison between simplest valid solution, best CX, and higher-complexity solution",
      "properties": {
        "simplest_valid_solution": {
          "type": "string"
        },
        "best_cx_solution": {
          "type": "string"
        },
        "higher_complexity_solution": {
          "type": "string"
        },
        "selection_reason": {
          "type": "string"
        },
        "complexity_rationale": {
          "type": "string"
        },
        "rejected_modalities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "web",
          "ios",
          "android",
          "macos",
          "windows",
          "linux",
          "chrome",
          "firefox",
          "edge",
          "terminal",
          "agnostic"
        ]
      },
      "description": "Target OS or platform environments"
    },
    "target_environment": {
      "type": "string",
      "description": "Runtime or hosting environment (local browser, Docker, cloud serverless, node, python)"
    },
    "delivery_channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "How customer accesses product (direct download, web URL, marketplace, npm)"
    },
    "target_customer": {
      "type": "object",
      "required": [
        "segment",
        "role",
        "sophistication_level"
      ],
      "properties": {
        "segment": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sophistication_level": {
          "type": "string"
        }
      }
    },
    "problem": {
      "type": "string",
      "description": "Specific problem being solved"
    },
    "job_to_be_done": {
      "type": "string",
      "description": "Customer functional and emotional objective"
    },
    "transformation": {
      "type": "object",
      "required": [
        "from_state",
        "to_state"
      ],
      "properties": {
        "from_state": {
          "type": "string"
        },
        "to_state": {
          "type": "string"
        }
      }
    },
    "promise": {
      "type": "string",
      "description": "Core product promise"
    },
    "unique_mechanism": {
      "type": "string",
      "description": "Distinctive methodology, system, algorithm, or framework that powers the result"
    },
    "positioning": {
      "type": "string",
      "description": "Positioning relative to alternatives and current workarounds"
    },
    "architecture": {
      "type": "object",
      "description": "Technical architecture blueprint for software, tool, API, database, or hybrid products",
      "properties": {
        "topology": {
          "type": "string"
        },
        "frontend": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "auth": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        }
      }
    },
    "technical_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Software frameworks, runtimes, or libraries required"
    },
    "external_services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "purpose",
          "integration_status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "integration_status": {
            "type": "string",
            "enum": [
              "integrated",
              "mocked",
              "external_setup_required"
            ]
          }
        }
      }
    },
    "data_requirements": {
      "type": "object",
      "description": "Persistence, caching, privacy, and data storage needs",
      "properties": {
        "persistence_type": {
          "type": "string"
        },
        "privacy_level": {
          "type": "string"
        },
        "schema_definition": {
          "type": "string"
        }
      }
    },
    "security_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Input validation, auth boundaries, secrets handling, safe fallbacks"
    },
    "build_requirements": {
      "type": "object",
      "properties": {
        "tooling_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "build_command": {
          "type": "string"
        },
        "output_directory": {
          "type": "string"
        }
      }
    },
    "runtime_requirements": {
      "type": "object",
      "properties": {
        "minimum_os": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        },
        "memory_estimate": {
          "type": "string"
        }
      }
    },
    "deployment_requirements": {
      "type": "object",
      "properties": {
        "target_host": {
          "type": "string"
        },
        "configuration_template": {
          "type": "string"
        }
      }
    },
    "maintenance_requirements": {
      "type": "string",
      "description": "Expected upkeep, update frequency, or operational monitoring"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "title",
          "objective"
        ],
        "properties": {
          "module_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "key_takeaway": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "format",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "output_path": {
            "type": "string"
          }
        }
      }
    },
    "bundle_components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "modality",
          "description"
        ],
        "properties": {
          "component_id": {
            "type": "string"
          },
          "modality": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "responsible_agent": {
            "type": "string"
          }
        }
      },
      "description": "For hybrid products, the specific components spanning multiple modalities"
    },
    "design_requirements": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string"
        },
        "visual_tone": {
          "type": "string"
        },
        "key_visual_components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "distribution_assumptions": {
      "type": "object",
      "properties": {
        "primary_channel": {
          "type": "string"
        },
        "creator_collaboration_hypothesis": {
          "type": "string"
        },
        "creator_specific_versioning": {
          "type": "object",
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "configurable_elements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "creator_onboarding_guide": {
              "type": "string"
            }
          }
        }
      }
    },
    "pricing_hypothesis": {
      "type": "object",
      "properties": {
        "suggested_price_tier": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "quality_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Explicit criteria required for QA and Critic audit approval"
    },
    "creative_concept": {
      "type": "object",
      "description": "Creative concept path, personality, and visual world metadata",
      "properties": {
        "concept_path": { "type": "string" },
        "personality_archetype": { "type": "string" },
        "visual_metaphor": { "type": "string" }
      }
    },
    "signature_mechanism": {
      "type": "object",
      "description": "Distinctive proprietary framework, engine, or rubric",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "purpose": { "type": "string" },
        "demonstration_potential": { "type": "string" }
      }
    },
    "customer_wow": {
      "type": "object",
      "description": "Deliberately designed first value and peak memorable moment",
      "properties": {
        "ttfr_seconds": { "type": "integer" },
        "first_visible_transformation": { "type": "string" },
        "peak_moment": { "type": "string" }
      }
    },
    "asset_manifest_path": {
      "type": "string",
      "description": "Path to visual asset manifest tracking 17-point asset records"
    },
    "merchandising_structure": {
      "type": "object",
      "description": "Commercial offer structure, tiering, and proof mechanisms",
      "properties": {
        "tier": { "type": "string" },
        "price_usd": { "type": "number" },
        "promise": { "type": "string" },
        "next_logical_offer": { "type": "string" }
      }
    }
  }
}