{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Audit",
  "type": "object",
  "required": [
    "product_id",
    "status",
    "audit_timestamp",
    "critical_issues_count",
    "high_issues_count",
    "medium_issues_count",
    "low_issues_count",
    "findings",
    "final_recommendation"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Identifier of the audited product"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail"],
      "description": "Audit outcome. FAIL if any CRITICAL or HIGH issue is un-waived"
    },
    "audit_timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of when audit was conducted"
    },
    "critical_issues_count": {
      "type": "integer",
      "minimum": 0
    },
    "high_issues_count": {
      "type": "integer",
      "minimum": 0
    },
    "medium_issues_count": {
      "type": "integer",
      "minimum": 0
    },
    "low_issues_count": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "title",
          "description",
          "location",
          "remediation_owner",
          "remediation_required"
        ],
        "properties": {
          "id": {"type": "string"},
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "category": {
            "type": "string",
            "enum": [
              "problem_solution_fit",
              "target_customer_fit",
              "usefulness",
              "differentiation",
              "factual_accuracy",
              "unsupported_claims",
              "logical_errors",
              "missing_information",
              "unnecessary_information",
              "usability",
              "consistency",
              "visual_quality",
              "taste_and_aesthetic_maturity",
              "psychology_and_dark_patterns",
              "asset_provenance_and_licensing",
              "positioning",
              "marketability",
              "creator_distribution_compatibility"
            ]
          },
          "title": {"type": "string"},
          "description": {"type": "string"},
          "location": {"type": "string"},
          "remediation_owner": {
            "type": "string",
            "enum": [
              "product-builder",
              "design-director",
              "creative-director",
              "asset-director",
              "taste-reviewer",
              "marketing-strategist",
              "packaging",
              "product-strategist",
              "opportunity-analyst"
            ]
          },
          "remediation_required": {"type": "string"}
        }
      }
    },
    "audit_breakdown": {
      "type": "object",
      "properties": {
        "problem_solution_fit": {"type": "string"},
        "factual_accuracy": {"type": "string"},
        "usability": {"type": "string"},
        "visual_quality": {"type": "string"},
        "taste_review": {"type": "string"},
        "psychology_review": {"type": "string"},
        "commercial_review": {"type": "string"},
        "creator_fit_review": {"type": "string"}
      }
    },
    "final_recommendation": {
      "type": "string",
      "description": "Executive summary of audit determination and mandatory remediation gates"
    }
  }
}
